/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}
page {
  overflow: hidden;
}
/* 新增功能 */
.button-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 原有按钮样式保留 */
.translate-btn {
  background: #757575;
  color: white;
  padding: 5px 0;
  width: 140px;
  text-align: center;
  border-radius: 100px;
}

/* 新增拍照按钮样式 */
.camera-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ede7f6;
  border-radius: 100px;
  padding: 5px 12px;
  height: 44px;
}

.camera-icon {
  width: 20px;
  height: 20px;
  margin-right: 6rpx;
}

.camera-text {
  font-size: 14px;
  color: #333;
}


