.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background: linear-gradient(to bottom, #d1c4e9, #90caf9);
  height: 100vh;
}
.title {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 10px;
}
.input-box, .output-box {
  width: 90%;
  height: 32vh;
  margin: 10px 0;
  padding: 10px;
  border-radius: 10px;
  border: none;
  background: rgba(255, 255, 255, 0.5);
}
